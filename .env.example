OPENAI_API_KEY=sk-your-api-key-here

# Vespa SSL configuration
VESPA_CERT_PATH=./security/vespa-cert.pem
VESPA_KEY_PATH=./security/vespa-key.pem
VESPA_CA_CERT_PATH=./security/clients.pem

# Model configuration
MODEL_NAME=deepfile/multilingual-e5-small-onnx-qint8
WHISPER_MODEL=small

# Processing limits
PDF_DPI=400
MAX_FILE_SIZE_MB=50
REQUEST_TIMEOUT=30

# Security settings (comma-separated domains, leave empty to allow all)
ALLOWED_DOMAINS=